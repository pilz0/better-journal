<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext (http://) is allowed so the AI assistant can reach self-hosted model
  servers on a local network (Ollama, LM Studio, llama.cpp, ...), which rarely
  have TLS. The app's built-in network requests all use https://; plain http is
  only used for addresses the user types into the AI settings, and the settings
  warn when such an address is not on this device.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
